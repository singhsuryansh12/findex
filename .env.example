# Server-only credentials. Never expose these with NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=
TWELVE_DATA_API_KEY=

# The build model is enforced as gpt-5.6-sol. Non-Sol overrides are ignored.
OPENAI_BUILD_MODEL=gpt-5.6-sol

# auto: Vercel Sandbox in production, local parity validation in development.
# Other supported values: local, vercel, disabled.
WORKSPACE_EXECUTION_MODE=auto
VERCEL_SANDBOX_SNAPSHOT_ID=

DEMO_AS_OF=2026-07-19
DEMO_SEED=findex-2026
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

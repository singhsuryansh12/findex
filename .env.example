# Server-only credentials. Never expose these with NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=
# Optional dedicated credential for Codex automation. Hosted E2B generation
# falls back to OPENAI_API_KEY when this is empty.
CODEX_API_KEY=
E2B_API_KEY=
E2B_TEMPLATE=findex-codex-widget:v2

OPENAI_CHAT_MODEL=gpt-5.6-terra
CODEX_MODEL=gpt-5.3-codex
CODEX_REASONING_EFFORT=high
# Signed-in local CLI defaults prioritize the 90-second interactive demo budget.
LOCAL_CODEX_MODEL=gpt-5.6-terra
LOCAL_CODEX_REASONING_EFFORT=medium

DEMO_AS_OF=2026-07-19
DEMO_SEED=findex-2026
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# Set false to serve the versioned, clearly labeled fallback artifact.
ENABLE_LIVE_WIDGETS=true
# auto: E2B in configured production, local Codex CLI in development.
# Other supported values: local, e2b, disabled.
WIDGET_EXECUTION_MODE=auto

# Server-only credentials. Never expose these with NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=
E2B_API_KEY=
E2B_TEMPLATE=findex-codex-widget:v1

OPENAI_CHAT_MODEL=gpt-5.6-terra
CODEX_MODEL=gpt-5.3-codex

DEMO_AS_OF=2026-07-19
DEMO_SEED=findex-2026
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# Set false to serve the versioned, clearly labeled fallback artifact.
ENABLE_LIVE_WIDGETS=true

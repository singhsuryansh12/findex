{
  "name": "findex-financial-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern coverage",
    "validate": "npm run typecheck && npm run test && npm run lint && npm run build",
    "verify:local": "npm run validate && npm run test:local-sandbox && playwright test",
    "sandbox:snapshot": "tsx scripts/create-workspace-snapshot.ts",
    "test:gen-eval": "vitest run tests/evaluations/generative-eval.test.ts",
    "test:local-sandbox": "RUN_LOCAL_SANDBOX_EVAL=1 vitest run tests/integration/local-sandbox.test.ts",
    "test:live-providers": "vitest run tests/evaluations/live-providers.test.ts",
    "verify:live-fire-local": "tsx scripts/verify-live-fire-local.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "^2.7.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "openai": "^6.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.9.2",
    "workflow": "4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.14"
  },
  "type": "module"
}
